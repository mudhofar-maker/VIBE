rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.username is string && data.username.size() >= 2 && data.username.size() <= 50 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 500)) &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 1000)) &&
             (!('followingCount' in data) || data.followingCount is int) &&
             (!('followersCount' in data) || data.followersCount is int) &&
             (!('likesReceivedCount' in data) || data.likesReceivedCount is int);
    }

    function isValidVideo(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.videoUrl is string && data.videoUrl.size() > 0 && data.videoUrl.size() <= 2000 &&
             data.thumbnailUrl is string && data.thumbnailUrl.size() > 0 && data.thumbnailUrl.size() <= 2000 &&
             data.creatorUsername is string && data.creatorUsername.size() >= 2 && data.creatorUsername.size() <= 50 &&
             (!('creatorName' in data) || data.creatorName == null || (data.creatorName is string && data.creatorName.size() <= 100)) &&
             (!('creatorAvatar' in data) || data.creatorAvatar == null || (data.creatorAvatar is string && data.creatorAvatar.size() <= 1000)) &&
             data.caption is string && data.caption.size() <= 2000 &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 30 && (data.tags.size() == 0 || data.tags[0] is string))) &&
             (!('soundTitle' in data) || data.soundTitle == null || (data.soundTitle is string && data.soundTitle.size() <= 200)) &&
             (!('soundAuthor' in data) || data.soundAuthor == null || (data.soundAuthor is string && data.soundAuthor.size() <= 100)) &&
             (!('soundCoverUrl' in data) || data.soundCoverUrl == null || (data.soundCoverUrl is string && data.soundCoverUrl.size() <= 1000)) &&
             (!('category' in data) || data.category == null || (data.category is string && data.category.size() <= 100)) &&
             (!('likesCount' in data) || data.likesCount is int) &&
             (!('commentsCount' in data) || data.commentsCount is int) &&
             (!('bookmarksCount' in data) || data.bookmarksCount is int) &&
             (!('sharesCount' in data) || data.sharesCount is int);
    }

    function isValidInteraction(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.videoId is string && data.videoId.size() > 0 && data.videoId.size() <= 128 &&
             data.isLiked is bool &&
             data.isBookmarked is bool &&
             data.isShared is bool;
    }

    function isValidComment(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.videoId is string && data.videoId.size() > 0 && data.videoId.size() <= 128 &&
             data.username is string && data.username.size() >= 2 && data.username.size() <= 50 &&
             (!('userAvatar' in data) || data.userAvatar == null || (data.userAvatar is string && data.userAvatar.size() <= 1000)) &&
             data.commentText is string && data.commentText.size() > 0 && data.commentText.size() <= 1000 &&
             (!('likesCount' in data) || data.likesCount is int);
    }

    function isValidFollowing(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.creatorUsername is string && data.creatorUsername.size() >= 2 && data.creatorUsername.size() <= 50 &&
             (!('creatorName' in data) || data.creatorName == null || (data.creatorName is string && data.creatorName.size() <= 100)) &&
             (!('creatorAvatar' in data) || data.creatorAvatar == null || (data.creatorAvatar is string && data.creatorAvatar.size() <= 1000));
    }

    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'username', 'displayName', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'username', 'displayName', 'bio', 'avatarUrl', 'followingCount', 'followersCount', 'likesReceivedCount', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['username', 'displayName', 'bio', 'avatarUrl', 'followingCount', 'followersCount', 'likesReceivedCount', 'updatedAt']) &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time));

      allow delete: if isSignedIn() && request.auth.uid == userId;

      // Subcollection: videos
      match /videos/{videoId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         isValidId(videoId) &&
                         incoming().keys().hasAll(['userId', 'videoUrl', 'thumbnailUrl', 'creatorUsername', 'caption', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'videoUrl', 'thumbnailUrl', 'creatorUsername', 'creatorName', 'creatorAvatar', 'caption', 'tags', 'soundTitle', 'soundAuthor', 'soundCoverUrl', 'category', 'likesCount', 'commentsCount', 'bookmarksCount', 'sharesCount', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                         isValidVideo(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(videoId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidVideo(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'tags', 'soundTitle', 'soundAuthor', 'soundCoverUrl', 'category', 'likesCount', 'commentsCount', 'bookmarksCount', 'sharesCount', 'updatedAt']) &&
                         (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time));

        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(videoId);
      }

      // Subcollection: interactions
      match /interactions/{interactionId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         isValidId(interactionId) &&
                         incoming().keys().hasAll(['userId', 'videoId', 'isLiked', 'isBookmarked', 'isShared', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'videoId', 'isLiked', 'isBookmarked', 'isShared', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                         isValidInteraction(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(interactionId) &&
                         incoming().userId == existing().userId &&
                         incoming().videoId == existing().videoId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidInteraction(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['isLiked', 'isBookmarked', 'isShared', 'updatedAt']) &&
                         (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time));

        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(interactionId);
      }

      // Subcollection: comments
      match /comments/{commentId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         isValidId(commentId) &&
                         incoming().keys().hasAll(['userId', 'videoId', 'username', 'commentText', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'videoId', 'username', 'userAvatar', 'commentText', 'likesCount', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                         isValidComment(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(commentId) &&
                         incoming().userId == existing().userId &&
                         incoming().videoId == existing().videoId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidComment(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['commentText', 'likesCount', 'updatedAt']) &&
                         (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time));

        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(commentId);
      }

      // Subcollection: following
      match /following/{followingId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         isValidId(followingId) &&
                         incoming().keys().hasAll(['userId', 'creatorUsername', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'creatorUsername', 'creatorName', 'creatorAvatar', 'createdAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         isValidFollowing(incoming());

        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(followingId);
      }
    }
  }
}
